    /* =========================================================
       INSTALL CSS
       ========================================================= */

    function installCSS() {

        let old = document.getElementById(THEME_ID);

        if (old) {
            old.remove();
        }

        const newStyle = document.createElement('style');

        newStyle.id = THEME_ID;
        newStyle.textContent = css;

        document.head.appendChild(newStyle);
    }


    /* =========================================================
       🌸 CREATE PETALS
       ========================================================= */

    function createPetals() {

        if (!document.body) return;

        if (document.getElementById('sakura-petal-layer')) {
            return;
        }

        /* Petal layer */

        const layer = document.createElement('div');

        layer.id =
            'sakura-petal-layer';

        /* Create 30 petals */

        for (let i = 0; i < 30; i++) {

            const petal =
                document.createElement('span');

            petal.className =
                'sakura-petal';

            /*
                Bigger petals:
                roughly 16px - 32px
            */

            const size =
                16 + Math.random() * 16;

            const left =
                Math.random() * 100;

            const delay =
                Math.random() * -18;

            const duration =
                9 + Math.random() * 12;

            const drift =
                -140 + Math.random() * 280;

            const opacity =
                .20 + Math.random() * .32;

            petal.style.width =
                `${size}px`;

            petal.style.height =
                `${size * .72}px`;

            petal.style.left =
                `${left}%`;

            petal.style.opacity =
                opacity;

            petal.style.animationDuration =
                `${duration}s`;

            petal.style.animationDelay =
                `${delay}s`;

            petal.style.setProperty(
                '--drift',
                `${drift}px`
            );

            /*
                Random starting rotation
            */

            petal.style.transform =
                `rotate(${Math.random() * 360}deg)`;

            layer.appendChild(petal);
        }

        document.body.appendChild(layer);


        /* =====================================================
           🌙 MOON
           ===================================================== */

        if (!document.getElementById('sakura-moon')) {

            const moon =
                document.createElement('div');

            moon.id =
                'sakura-moon';

            document.body.appendChild(moon);
        }


        /* =====================================================
           ✨ GLOW
           ===================================================== */

        if (!document.getElementById('sakura-glow')) {

            const glow =
                document.createElement('div');

            glow.id =
                'sakura-glow';

            document.body.appendChild(glow);
        }
    }


    /* =========================================================
       🚀 START
       ========================================================= */

    function start() {

        if (document.head) {
            installCSS();
        }

        if (document.body) {
            createPetals();
        }
    }


    /* =========================================================
       🧹 CLEANUP OLD VERSIONS
       ========================================================= */

    function cleanupOldThemes() {

        const oldThemeIds = [
            'blacket-sakura-theme',
            'blacket-sakura-night',
            'blacket-retro-arcade'
        ];

        oldThemeIds.forEach(id => {

            const element =
                document.getElementById(id);

            if (element) {
                element.remove();
            }
        });

        /* Remove old petal layers */

        [
            'sakura-petal-layer',
            'sakura-moon',
            'sakura-glow'
        ].forEach(id => {

            const element =
                document.getElementById(id);

            if (element) {
                element.remove();
            }
        });
    }


    cleanupOldThemes();


    /* =========================================================
       ⚡ INITIAL LOAD
       ========================================================= */

    if (document.readyState === 'loading') {

        document.addEventListener(
            'DOMContentLoaded',
            start,
            { once: true }
        );

    } else {

        start();
    }


    /* =========================================================
       🔄 HANDLE BLACKET PAGE CHANGES
       ========================================================= */

    const observer =
        new MutationObserver(() => {

            if (!document.getElementById(THEME_ID) &&
                document.head) {

                installCSS();
            }

            if (!document.getElementById('sakura-petal-layer') &&
                document.body) {

                createPetals();
            }
        });


    observer.observe(
        document.documentElement,
        {
            childList: true,
            subtree: true
        }
    );

